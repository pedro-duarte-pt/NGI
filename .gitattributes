# Default text handling
* text=auto

# Source code - keep consistent LF in repository
*.c       text eol=lf
*.h       text eol=lf
*.cs      text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf

# Unity text assets
*.unity   text eol=lf
*.prefab  text eol=lf
*.asset   text eol=lf
*.meta    text eol=lf
*.uss     text eol=lf
*.uxml    text eol=lf

# Scripts
*.sh      text eol=lf

# Windows scripts
*.bat     text eol=crlf
*.cmd     text eol=crlf

# Binary files
*.png     binary
*.jpg     binary
*.jpeg    binary
*.dll     binary
*.hex     binary