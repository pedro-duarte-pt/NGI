{
  "id": "preferences",
  "title": "Preferences",
  "style": "styles.json",
  "layout": {
    "type": "grid",
    "columns": 6,
    "rows": 7,
    "gap": 12,
    "padding": 18
  },
  "widgets": [
    {
      "type": "text",
      "id": "preferences-title",
      "styleClass": "preferences-title",
      "layout": {
        "x": 0,
        "y": 0,
        "width": 5,
        "height": 1
      },
      "props": {
        "text": "UNIT PREFERENCES"
      }
    },
    {
      "type": "actionButton",
      "id": "back-button",
      "layout": {
        "x": 5,
        "y": 0,
        "width": 1,
        "height": 1
      },
      "props": {
        "text": "BACK",
        "action": "back",
        "fallbackScreen": "diagnostics"
      }
    },
    {
      "type": "preferenceSelector",
      "layout": {
        "x": 0,
        "y": 1,
        "width": 3,
        "height": 1
      },
      "props": {
        "preference": "units.temperature"
      }
    },
    {
      "type": "preferenceSelector",
      "layout": {
        "x": 3,
        "y": 1,
        "width": 3,
        "height": 1
      },
      "props": {
        "preference": "units.speed"
      }
    },
    {
      "type": "preferenceSelector",
      "layout": {
        "x": 0,
        "y": 2,
        "width": 3,
        "height": 1
      },
      "props": {
        "preference": "units.pressure"
      }
    },
    {
      "type": "preferenceSelector",
      "layout": {
        "x": 3,
        "y": 2,
        "width": 3,
        "height": 1
      },
      "props": {
        "preference": "units.distance"
      }
    },
    {
      "type": "preferenceSelector",
      "layout": {
        "x": 0,
        "y": 3,
        "width": 6,
        "height": 1
      },
      "props": {
        "preference": "units.fuelConsumption"
      }
    }
  ]
}