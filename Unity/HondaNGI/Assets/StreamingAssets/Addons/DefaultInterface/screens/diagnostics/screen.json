{
  "id": "diagnostics",
  "title": "Sensor Diagnostics",
  "style": "styles.json",
  "widgets": [
    {
      "type": "dashboardHeader",
      "x": 0,
      "y": 0,
      "width": 10,
      "height": 1
    },

    { "type": "sensor", "sensor": "engine.rpm",                    "traceColor": "#FF2020", "x": 0, "y": 1, "width": 1, "height": 1 },
    { "type": "sensor", "sensor": "drivetrain.vehicle_speed",     "traceColor": "#8D3CFF", "x": 1, "y": 1, "width": 1, "height": 1 },
    { "type": "sensor", "sensor": "intake.throttle.position",     "traceColor": "#39B93B", "x": 0, "y": 2, "width": 1, "height": 1 },
    { "type": "sensor", "sensor": "engine.coolant_temperature",   "traceColor": "#F28C00", "x": 1, "y": 2, "width": 1, "height": 1 },
    { "type": "sensor", "sensor": "exhaust.oxygen.narrowband",    "traceColor": "#20AEB1", "x": 0, "y": 3, "width": 1, "height": 1 },
    { "type": "sensor", "sensor": "diagnostics.mil",              "traceColor": "#B24DFF", "x": 1, "y": 3, "width": 1, "height": 1 },
    { "type": "sensor", "sensor": "electrical.battery.voltage",   "traceColor": "#E8D500", "x": 0, "y": 4, "width": 1, "height": 1 },
    { "type": "sensor", "sensor": "intake.air_temperature",       "traceColor": "#2387D9", "x": 1, "y": 4, "width": 1, "height": 1 },
    { "type": "sensor", "sensor": "engine.cooling.fan",           "traceColor": "#39B93B", "x": 0, "y": 5, "width": 1, "height": 1 },
    { "type": "sensor", "sensor": "engine.vtec.pressure",         "traceColor": "#FF2020", "x": 1, "y": 5, "width": 1, "height": 1 },
    { "type": "sensor", "sensor": "engine.vtec.left",             "traceColor": "#E8D500", "x": 0, "y": 6, "width": 1, "height": 1 },
    { "type": "sensor", "sensor": "engine.vtec.right",            "traceColor": "#E8D500", "x": 1, "y": 6, "width": 1, "height": 1 },

    {
      "type": "sensorTrace",
      "x": 2,
      "y": 1,
      "width": 8,
      "height": 6,
      "sensors": ["engine.rpm"],
      "windowSeconds": 10,
      "maxTraces": 5,
      "traceColors": [
        "#FF2020",
        "#8D3CFF",
        "#39B93B",
        "#F28C00",
        "#20AEB1"
      ]
    }
  ]
}
