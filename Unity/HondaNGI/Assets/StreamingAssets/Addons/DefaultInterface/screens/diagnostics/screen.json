{
  "id": "diagnostics",
  "title": "Sensor Diagnostics",
  "style": "styles.json",
  "widgets": [
    {
      "type": "container",
      "id": "diagnostics-header",
      "styleClass": "dashboard-header",
      "layout": {
        "x": 0,
        "y": 0,
        "width": 10,
        "height": 1
      },
      "children": [
        {
          "type": "image",
          "id": "honda-logo",
          "styleClass": "dashboard-logo",
          "props": {
            "asset": "assets/honda-logo.png",
            "scaleMode": "fit"
          }
        },
        {
          "type": "container",
          "id": "header-title-block",
          "styleClass": "dashboard-title-block",
          "children": [
            {
              "type": "text",
              "id": "header-title",
              "styleClass": "dashboard-title",
              "props": {
                "text": "SENSOR DIAGNOSTICS"
              }
            },
            {
              "type": "text",
              "id": "header-subtitle",
              "styleClass": "dashboard-subtitle",
              "props": {
                "text": "HONDA DEL SOL VTi"
              }
            }
          ]
        }
      ]
    },
    {
      "type": "sensor",
      "layout": {
        "x": 0,
        "y": 1,
        "width": 1,
        "height": 1
      },
      "props": {
        "sensor": "engine.rpm",
        "traceColor": "#FF2020"
      }
    },
    {
      "type": "sensor",
      "layout": {
        "x": 1,
        "y": 1,
        "width": 1,
        "height": 1
      },
      "props": {
        "sensor": "drivetrain.vehicle_speed",
        "traceColor": "#8D3CFF"
      }
    },
    {
      "type": "sensor",
      "layout": {
        "x": 0,
        "y": 2,
        "width": 1,
        "height": 1
      },
      "props": {
        "sensor": "intake.throttle.position",
        "traceColor": "#39B93B"
      }
    },
    {
      "type": "sensor",
      "layout": {
        "x": 1,
        "y": 2,
        "width": 1,
        "height": 1
      },
      "props": {
        "sensor": "engine.coolant_temperature",
        "traceColor": "#F28C00"
      }
    },
    {
      "type": "sensor",
      "layout": {
        "x": 0,
        "y": 3,
        "width": 1,
        "height": 1
      },
      "props": {
        "sensor": "exhaust.oxygen.narrowband",
        "traceColor": "#20AEB1"
      }
    },
    {
      "type": "sensor",
      "layout": {
        "x": 1,
        "y": 3,
        "width": 1,
        "height": 1
      },
      "props": {
        "sensor": "diagnostics.mil",
        "traceColor": "#B24DFF"
      }
    },
    {
      "type": "sensor",
      "layout": {
        "x": 0,
        "y": 4,
        "width": 1,
        "height": 1
      },
      "props": {
        "sensor": "electrical.battery.voltage",
        "traceColor": "#E8D500"
      }
    },
    {
      "type": "sensor",
      "layout": {
        "x": 1,
        "y": 4,
        "width": 1,
        "height": 1
      },
      "props": {
        "sensor": "intake.air_temperature",
        "traceColor": "#2387D9"
      }
    },
    {
      "type": "sensor",
      "layout": {
        "x": 0,
        "y": 5,
        "width": 1,
        "height": 1
      },
      "props": {
        "sensor": "engine.cooling.fan",
        "traceColor": "#39B93B"
      }
    },
    {
      "type": "sensor",
      "layout": {
        "x": 1,
        "y": 5,
        "width": 1,
        "height": 1
      },
      "props": {
        "sensor": "engine.vtec.pressure",
        "traceColor": "#FF2020"
      }
    },
    {
      "type": "sensor",
      "layout": {
        "x": 0,
        "y": 6,
        "width": 1,
        "height": 1
      },
      "props": {
        "sensor": "engine.vtec.left",
        "traceColor": "#E8D500"
      }
    },
    {
      "type": "sensor",
      "layout": {
        "x": 1,
        "y": 6,
        "width": 1,
        "height": 1
      },
      "props": {
        "sensor": "engine.vtec.right",
        "traceColor": "#E8D500"
      }
    },
    {
      "type": "sensorTrace",
      "layout": {
        "x": 2,
        "y": 1,
        "width": 8,
        "height": 6
      },
      "props": {
        "sensors": [
          "engine.rpm"
        ],
        "windowSeconds": 10,
        "maxTraces": 5,
        "traceColors": [
          "#FF2020",
          "#8D3CFF",
          "#39B93B",
          "#F28C00",
          "#20AEB1"
        ]
      }
    }
  ]
}