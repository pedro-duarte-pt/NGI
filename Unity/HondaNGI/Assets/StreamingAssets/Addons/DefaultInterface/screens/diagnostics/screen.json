{
  "id": "diagnostics",
  "title": "Sensor Diagnostics",
  "style": "styles.json",
  "layout": {
    "type": "grid",
    "columns": 12,
    "rows": 9,
    "gap": 12,
    "padding": 0
  },
  "widgets": [
    {
      "type": "container",
      "id": "diagnostics-header",
      "styleClass": "dashboard-header",
      "layout": {
        "x": 0,
        "y": 0,
        "width": 12,
        "height": 1
      },
      "children": [
        {
          "type": "image",
          "id": "honda-logo",
          "styleClass": "dashboard-logo",
          "props": {
            "asset": "assets/honda-logo.png",
            "scaleMode": "fit"
          }
        },
        {
          "type": "container",
          "id": "header-title-block",
          "styleClass": "dashboard-title-block",
          "children": [
            {
              "type": "text",
              "id": "header-title",
              "styleClass": "dashboard-title",
              "props": {
                "text": "SENSOR DIAGNOSTICS"
              }
            },
            {
              "type": "text",
              "id": "header-subtitle",
              "styleClass": "dashboard-subtitle",
              "props": {
                "text": "HONDA DEL SOL VTi"
              }
            }
          ]
        }
      ]
    },
    {
      "type": "conditionalImage",
      "id": "mil-indicator",
      "layout": {
        "x": 10,
        "y": 0,
        "width": 1,
        "height": 1
      },
      "props": {
        "cases": [
          {
            "when": {
              "sensor": "diagnostics.mil",
              "operator": "==",
              "value": 1
            },
            "asset": "assets/MIL_ON.png"
          }
        ],
        "default": {
          "asset": "assets/MIL_OFF.png"
        },
        "scaleMode": "fit"
      }
    },
    {
      "type": "actionButton",
      "id": "settings-button",
      "layout": {
        "x": 11,
        "y": 0,
        "width": 1,
        "height": 1
      },
      "props": {
        "text": "SETTINGS",
        "action": "navigate",
        "screen": "preferences"
      }
    },
    {
      "type": "sensor",
      "layout": {
        "x": 0,
        "y": 1,
        "width": 1,
        "height": 1
      },
      "props": {
        "sensor": "engine.rpm",
        "traceColor": "#FF2020"
      }
    },
    {
      "type": "sensor",
      "layout": {
        "x": 1,
        "y": 1,
        "width": 1,
        "height": 1
      },
      "props": {
        "sensor": "drivetrain.adjusted_speed",
        "traceColor": "#8D3CFF"
      }
    },
    {
      "type": "sensor",
      "layout": {
        "x": 0,
        "y": 2,
        "width": 1,
        "height": 1
      },
      "props": {
        "sensor": "intake.throttle.position",
        "traceColor": "#39B93B"
      }
    },
    {
      "type": "sensor",
      "layout": {
        "x": 1,
        "y": 2,
        "width": 1,
        "height": 1
      },
      "props": {
        "sensor": "engine.coolant_temperature",
        "traceColor": "#F28C00"
      }
    },
    {
      "type": "conditionalSensor",
      "id": "narrowband-o2",
      "layout": {
        "x": 0,
        "y": 3,
        "width": 1,
        "height": 1
      },
      "props": {
        "label": "O2",
        "traceColor": "#20AEB1",
        "cases": [
          {
            "when": {
              "sensor": "exhaust.oxygen.narrowband",
              "operator": ">",
              "value": 0.5
            },
            "sensor": "exhaust.oxygen.narrowband"
          },
          {
            "when": {
              "sensor": "exhaust.oxygen.narrowband",
              "operator": ">=",
              "value": 0.4
            },
            "sensor": "exhaust.oxygen.narrowband",
            "backgroundColor": "#1F7A3A"
          }
        ],
        "default": {
          "sensor": "exhaust.oxygen.narrowband"
        }
      }
    },
    {
      "type": "sensor",
      "layout": {
        "x": 1,
        "y": 3,
        "width": 1,
        "height": 1
      },
      "props": {
        "sensor": "engine.injector.pulse_width",
        "traceColor": "#B24DFF"
      }
    },
    {
      "type": "sensor",
      "layout": {
        "x": 0,
        "y": 4,
        "width": 1,
        "height": 1
      },
      "props": {
        "sensor": "electrical.battery.voltage",
        "traceColor": "#E8D500"
      }
    },
    {
      "type": "sensor",
      "layout": {
        "x": 1,
        "y": 4,
        "width": 1,
        "height": 1
      },
      "props": {
        "sensor": "intake.air_temperature",
        "traceColor": "#2387D9"
      }
    },
    {
      "type": "sensor",
      "layout": {
        "x": 0,
        "y": 5,
        "width": 1,
        "height": 1
      },
      "props": {
        "sensor": "engine.cooling.fan",
        "traceColor": "#39B93B"
      }
    },
    {
      "type": "sensor",
      "layout": {
        "x": 1,
        "y": 5,
        "width": 1,
        "height": 1
      },
      "props": {
        "sensor": "engine.vtec.pressure",
        "traceColor": "#FF2020"
      }
    },
    {
      "type": "sensor",
      "layout": {
        "x": 0,
        "y": 6,
        "width": 1,
        "height": 1
      },
      "props": {
        "sensor": "engine.vtec.left",
        "traceColor": "#E8D500"
      }
    },
    {
      "type": "sensor",
      "layout": {
        "x": 1,
        "y": 6,
        "width": 1,
        "height": 1
      },
      "props": {
        "sensor": "engine.vtec.right",
        "traceColor": "#E8D500"
      }
    },
    {
      "type": "sensor",
      "id": "vehicle-odometer",
      "layout": {
        "x": 0,
        "y": 7,
        "width": 2,
        "height": 1
      },
      "props": {
        "sensor": "drivetrain.odometer",
        "traceColor": "#FFFFFF"
      }
    },
    {
      "type": "conditionalSensor",
      "id": "instant-fuel-consumption",
      "layout": {
        "x": 0,
        "y": 8,
        "width": 2,
        "height": 1
      },
      "props": {
        "label": "CONS",
        "traceColor": "#FFFFFF",
        "cases": [
          {
            "when": {
              "sensor": "engine.rpm",
              "operator": "<=",
              "value": 0
            },
            "message": "--"
          },
          {
            "when": {
              "sensor": "drivetrain.vehicle_speed",
              "operator": "<",
              "value": 1.3889
            },
            "sensor": "engine.fuel.rate"
          }
        ],
        "default": {
          "sensor": "engine.fuel.consumption"
        }
      }
    },
    {
      "type": "sensorTrace",
      "layout": {
        "x": 2,
        "y": 1,
        "width": 10,
        "height": 8
      },
      "props": {
        "sensors": [
          "engine.rpm"
        ],
        "windowSeconds": 10,
        "maxTraces": 5,
        "traceColors": [
          "#FF2020",
          "#8D3CFF",
          "#39B93B",
          "#F28C00",
          "#20AEB1"
        ],
        "windowOptions": [
          5,
          15,
          60
        ]
      }
    }
  ]
}